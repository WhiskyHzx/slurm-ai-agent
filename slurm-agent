#!/usr/bin/env python3
"""
Local launcher for slurm-ai-agent.

Run from the project root:

    ./slurm-agent

This launcher does not perform SSH login. It only reuses an existing VS Code
Remote-SSH SOCKS proxy, checks credentials, starts uvicorn, and prints the URL.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
import warnings
from pathlib import Path

from core.local_env import (
    DEFAULT_HOST,
    DEFAULT_PORT,
    ENV_PATH,
    PORT_SCAN_LIMIT,
    ROOT,
    VENV_PYTHON,
    find_existing_socks_proxy,
    load_dotenv,
    port_is_free,
    reexec_inside_venv,
    set_dotenv_value,
)
from core.token_manager import get_token_status


warnings.filterwarnings("ignore", message="urllib3 v2 only supports OpenSSL.*")


def check_slurm_api(proxy: str) -> tuple[bool, str]:
    token_status = get_token_status()
    if not token_status.present:
        return False, "SLURM_JWT is missing in .env"

    try:
        import requests
    except ImportError:
        return False, "requests is not installed; run .venv/bin/pip install -r requirements.txt"

    base_url = os.environ.get("SLURM_API_BASE_URL", "http://107.ustc.edu.cn:6820").rstrip("/")
    proxies = {"http": proxy, "https": proxy} if proxy else None
    try:
        resp = requests.get(
            f"{base_url}/slurm/v0.0.41/ping/",
            headers={"X-SLURM-USER-TOKEN": os.environ.get("SLURM_JWT", "")},
            proxies=proxies,
            timeout=8,
        )
    except Exception as exc:
        return False, f"{type(exc).__name__}: {exc}"

    if resp.status_code == 200:
        return True, "reachable"
    return False, f"HTTP {resp.status_code}: {resp.text[:160].replace(chr(10), ' ')}"


def check_llm_api() -> tuple[bool, str]:
    if not os.environ.get("LLM_API_KEY"):
        return False, "LLM_API_KEY is missing in .env"

    try:
        from agent.llm_provider import LLMProvider

        provider = LLMProvider(max_tokens=16)
        response = provider.chat(
            messages=[{"role": "user", "content": "Reply OK only."}],
            max_tokens=8,
        )
        reply = (response.choices[0].message.content or "").strip()
        return True, reply[:40] or "ok"
    except Exception as exc:
        return False, f"{type(exc).__name__}: {exc}"


def existing_server_url(host: str, port: int) -> str | None:
    url = f"http://{host}:{port}/health"
    try:
        with urllib.request.urlopen(url, timeout=0.5) as response:
            body = response.read().decode("utf-8", errors="replace")
    except (OSError, urllib.error.URLError):
        return None
    if response.status == 200 and '"status":"ok"' in body.replace(" ", ""):
        return f"http://{host}:{port}"
    return None


def pick_port(host: str, preferred: int) -> tuple[int, str | None]:
    existing = existing_server_url(host, preferred)
    if existing:
        return preferred, existing

    if port_is_free(host, preferred):
        return preferred, None

    for port in range(preferred + 1, preferred + PORT_SCAN_LIMIT + 1):
        existing = existing_server_url(host, port)
        if existing:
            return port, existing
        if port_is_free(host, port):
            return port, None

    raise RuntimeError(f"No free local port found from {preferred} to {preferred + PORT_SCAN_LIMIT}")


def start_server(host: str, port: int) -> subprocess.Popen:
    env = os.environ.copy()
    env["PYTHONPATH"] = "."
    env["PYTHONWARNINGS"] = "ignore:urllib3 v2 only supports OpenSSL"
    command = [
        str(VENV_PYTHON if VENV_PYTHON.exists() else sys.executable),
        "-m",
        "uvicorn",
        "server.app:app",
        "--host",
        host,
        "--port",
        str(port),
    ]
    return subprocess.Popen(command, cwd=str(ROOT), env=env)


def wait_for_server(host: str, port: int, process: subprocess.Popen) -> bool:
    for _ in range(40):
        if process.poll() is not None:
            return False
        if existing_server_url(host, port):
            return True
        time.sleep(0.25)
    return False


def print_token_status() -> None:
    status = get_token_status()
    print(f"SLURM_JWT: {status.preview}")
    if status.seconds_remaining is not None:
        hours = status.seconds_remaining / 3600
        print(f"SLURM_JWT remaining: {hours:.1f}h")
    elif status.present:
        print("SLURM_JWT remaining: unknown")


def main() -> int:
    reexec_inside_venv(Path(__file__).resolve(), sys.argv[1:])

    parser = argparse.ArgumentParser(description="Start slurm-ai-agent locally.")
    parser.add_argument("--host", default=DEFAULT_HOST)
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("--skip-checks", action="store_true", help="Start without API connectivity checks.")
    args = parser.parse_args()

    print("107 Slurm Agent local launcher")
    print(f"Project: {ROOT}")

    env_values = load_dotenv()
    if not ENV_PATH.exists():
        print("\n.env was not found.")
        print("Create it with SLURM_JWT, LLM_API_KEY, and optionally SLURM_API_PROXY.")
        return 2

    print_token_status()
    print(f"LLM_API_KEY: {'present' if os.environ.get('LLM_API_KEY') else 'missing'}")

    proxy = find_existing_socks_proxy(env_values.get("SLURM_API_PROXY", ""))
    if proxy:
        if proxy != env_values.get("SLURM_API_PROXY", ""):
            set_dotenv_value("SLURM_API_PROXY", proxy)
            print(f"Updated SLURM_API_PROXY: {proxy}")
        else:
            print(f"SLURM_API_PROXY: {proxy}")
    else:
        print("SLURM_API_PROXY: not found")
        print("Connect VS Code Remote-SSH to 107.ustc.edu.cn, then run this command again.")
        return 2

    if not args.skip_checks:
        ok, detail = check_slurm_api(proxy)
        print(f"Slurm API: {'OK' if ok else 'FAIL'} ({detail})")
        if not ok:
            print("If this is a 401, refresh SLURM_JWT on the remote login node.")
            print("Remote command: scontrol token lifespan=86400")
            return 2

        ok, detail = check_llm_api()
        print(f"LLM API: {'OK' if ok else 'FAIL'} ({detail})")
        if not ok:
            return 2

    try:
        port, existing_url = pick_port(args.host, args.port)
    except RuntimeError as exc:
        print(f"Port selection failed: {exc}")
        return 2

    if existing_url:
        print("\nServer is already running.")
        print(f"Open: {existing_url}")
        return 0

    print(f"Starting server on {args.host}:{port} ...")
    process = start_server(args.host, port)
    if not wait_for_server(args.host, port, process):
        print("Server failed to start. Recent uvicorn output should be visible above.")
        return process.returncode or 1

    url = f"http://{args.host}:{port}"
    print("\nServer started.")
    print(f"Open: {url}")
    print("\nLeave this terminal open. Press Ctrl+C to stop the server.")

    try:
        return process.wait()
    except KeyboardInterrupt:
        print("\nStopping server...")
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
